# Public values are bundled into the browser; never place secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side portal guard endpoint; may use a private backend address.
API_INTERNAL_BASE_URL=http://localhost:8080/api
# For a same-origin /api proxy in hosted Next.js, set this to the backend HTTPS origin.
# Then use NEXT_PUBLIC_API_BASE_URL=/api and API_INTERNAL_BASE_URL=<backend origin>/api.
API_PROXY_ORIGIN=
