# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/certchain
DATABASE_USERNAME=certchain
DATABASE_PASSWORD=change-me-for-local-development

# HTTP and browser origin
SERVER_PORT=8080
# Canonical public origin embedded in certificate PDFs and QR codes.
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication (generate at least 32 random bytes; never commit a real key)
JWT_ISSUER=certchain
JWT_SECRET_BASE64=replace-with-a-base64-encoded-random-secret
JWT_ACCESS_TOKEN_TTL=PT15M
AUTH_COOKIE_NAME=CERTCHAIN_AUTH
# Set false only for local HTTP. Production must use HTTPS and true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=

# Development-only bootstrap: also requires SPRING_PROFILES_ACTIVE=dev.
DEV_BOOTSTRAP_ENABLED=false
DEV_ORGANIZATION_NAME=
DEV_ORGANIZATION_EMAIL=
DEV_ADMIN_NAME=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# One-time local admin provisioning command (never set on the hosted service).
PROVISION_ADMIN_ENABLED=false
PROVISION_ORGANIZATION_NAME=
PROVISION_ORGANIZATION_EMAIL=
PROVISION_ADMIN_NAME=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=

# Generated artifacts
STORAGE_TYPE=local
STORAGE_ROOT=./storage
# For a private S3-compatible bucket in hosting; never use a public-read bucket.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Development email (Mailpit defaults)
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false
MAIL_FROM=certificates@certchain.local
MAIL_TIMEOUT_MS=5000
MAIL_RETRY_POLL_MS=60000

# Ethereum - leave disabled until a local contract or Sepolia is configured
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ISSUER_PRIVATE_KEY=
BLOCKCHAIN_CONFIRMATIONS=2
# First block containing the deployed registry; narrows crash-recovery event searches.
BLOCKCHAIN_DEPLOYMENT_BLOCK=0
# Maximum time an issue HTTP request waits for a receipt; later reconciliation continues.
BLOCKCHAIN_RECEIPT_TIMEOUT=PT30S

